rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(email) {
      return email is string
        && email.size() >= 5
        && email.size() <= 120
        && email.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email.lower() == 'balajeepathak74@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower()))
        );
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['id', 'empCode', 'name', 'department', 'breakMinutes', 'active'])
        && data.keys().hasOnly([
          'id',
          'empCode',
          'name',
          'department',
          'companyCategory',
          'breakMinutes',
          'hourlyRate',
          'active',
          'individualSheetId',
          'individualSheetUrl',
          'monthlyThikadaMinutes'
        ])
        && isValidId(data.id)
        && data.empCode is string && data.empCode.size() >= 1 && data.empCode.size() <= 30
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.department is string && data.department.size() >= 1 && data.department.size() <= 60
        && (!('companyCategory' in data) || data.companyCategory in ['Sukhsa Export Permanent', 'Sukhsa Export Temporary'])
        && data.breakMinutes is int && data.breakMinutes >= 0 && data.breakMinutes <= 180
        && (!('hourlyRate' in data) || (data.hourlyRate is number && data.hourlyRate >= 0 && data.hourlyRate <= 1000000))
        && data.active is bool
        && (!('individualSheetId' in data) || (data.individualSheetId is string && data.individualSheetId.size() <= 128))
        && (!('individualSheetUrl' in data) || (data.individualSheetUrl is string && data.individualSheetUrl.size() <= 300))
        && (!('monthlyThikadaMinutes' in data) || (data.monthlyThikadaMinutes is map && data.monthlyThikadaMinutes.size() <= 120));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll([
          'id',
          'date',
          'empId',
          'empCode',
          'empName',
          'inTime',
          'outTime',
          'isPaused',
          'pausedTotalSeconds',
          'grossMinutes',
          'breakMinutes',
          'netMinutes',
          'netDecimalHours',
          'overtimeMinutes',
          'overtimeDecimalHours',
          'isSunday',
          'status',
          'syncedToSheet',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'date',
          'empId',
          'empCode',
          'empName',
          'inTime',
          'outTime',
          'startedAtMs',
          'isPaused',
          'pausedAtMs',
          'pausedTotalSeconds',
          'grossMinutes',
          'breakMinutes',
          'netMinutes',
          'netDecimalHours',
          'overtimeMinutes',
          'overtimeDecimalHours',
          'presentCount',
          'thikadaMinutes',
          'normalMinutes',
          'normalDecimalHours',
          'isSunday',
          'status',
          'syncedToSheet',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.date is string && data.date.size() == 10 && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && isValidId(data.empId)
        && data.empCode is string && data.empCode.size() >= 1 && data.empCode.size() <= 30
        && data.empName is string && data.empName.size() >= 1 && data.empName.size() <= 80
        && data.inTime is string && data.inTime.size() == 5 && data.inTime.matches('^\\d{2}:\\d{2}$')
        && (data.outTime == null || (data.outTime is string && data.outTime.size() == 5 && data.outTime.matches('^\\d{2}:\\d{2}$')))
        && (!('startedAtMs' in data) || data.startedAtMs == null || (data.startedAtMs is int && data.startedAtMs >= 0))
        && data.isPaused is bool
        && (!('pausedAtMs' in data) || data.pausedAtMs == null || (data.pausedAtMs is int && data.pausedAtMs >= 0))
        && data.pausedTotalSeconds is int && data.pausedTotalSeconds >= 0 && data.pausedTotalSeconds <= 86400
        && (data.grossMinutes == null || (data.grossMinutes is int && data.grossMinutes >= 0 && data.grossMinutes <= 1440))
        && data.breakMinutes is int && data.breakMinutes >= 0 && data.breakMinutes <= 180
        && (data.netMinutes == null || (data.netMinutes is int && data.netMinutes >= 0 && data.netMinutes <= 1440))
        && (data.netDecimalHours == null || (data.netDecimalHours is number && data.netDecimalHours >= 0 && data.netDecimalHours <= 24))
        && (data.overtimeMinutes == null || (data.overtimeMinutes is int && data.overtimeMinutes >= 0 && data.overtimeMinutes <= 1440))
        && (data.overtimeDecimalHours == null || (data.overtimeDecimalHours is number && data.overtimeDecimalHours >= 0 && data.overtimeDecimalHours <= 24))
        && (!('presentCount' in data) || data.presentCount == null || (data.presentCount is int && data.presentCount >= 0 && data.presentCount <= 1))
        && (!('thikadaMinutes' in data) || (data.thikadaMinutes is int && data.thikadaMinutes >= 0 && data.thikadaMinutes <= 1440))
        && (!('normalMinutes' in data) || data.normalMinutes == null || (data.normalMinutes is int && data.normalMinutes >= 0 && data.normalMinutes <= 1440))
        && (!('normalDecimalHours' in data) || data.normalDecimalHours == null || (data.normalDecimalHours is number && data.normalDecimalHours >= 0 && data.normalDecimalHours <= 24))
        && data.isSunday is bool
        && data.status in ['on_duty', 'completed', 'short_shift']
        && data.syncedToSheet is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkspaceSettings(data) {
      return data.keys().hasAll(['spreadsheetId', 'spreadsheetTitle', 'spreadsheetUrl', 'tabNames', 'updatedAt'])
        && data.keys().hasOnly([
          'companyCategory',
          'spreadsheetId',
          'spreadsheetTitle',
          'spreadsheetUrl',
          'lastSyncedAt',
          'tabNames',
          'updatedAt'
        ])
        && (!('companyCategory' in data) || data.companyCategory in ['Sukhsa Export Permanent', 'Sukhsa Export Temporary'])
        && data.spreadsheetId is string && data.spreadsheetId.size() >= 1 && data.spreadsheetId.size() <= 128
        && data.spreadsheetTitle is string && data.spreadsheetTitle.size() >= 1 && data.spreadsheetTitle.size() <= 200
        && data.spreadsheetUrl is string && data.spreadsheetUrl.size() >= 1 && data.spreadsheetUrl.size() <= 300
        && (!('lastSyncedAt' in data) || data.lastSyncedAt == null || (data.lastSyncedAt is string && data.lastSyncedAt.size() <= 64))
        && data.tabNames is list && data.tabNames.size() <= 500
        && (data.tabNames.size() == 0 || data.tabNames[0] is string)
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidAdminEmail(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'addedBy', 'createdAt'])
        && isValidEmailId(data.email)
        && data.email == data.email.lower()
        && data.addedBy is string && data.addedBy.size() >= 3 && data.addedBy.size() <= 120
        && data.createdAt is timestamp;
    }

    match /employees/{empId} {
      allow get: if isValidId(empId) && (isAdmin() || existing().active == true);
      allow list: if isAdmin() || resource.data.active == true;
      allow create: if isAdmin() && isValidId(empId) && isValidEmployee(incoming()) && incoming().id == empId;
      allow update: if isAdmin() && isValidId(empId) && isValidEmployee(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin() && isValidId(empId);
    }

    match /attendance/{recordId} {
      allow get: if isValidId(recordId) && (isAdmin() || existing().date is string);
      allow list: if isAdmin() || (resource.data.date is string && resource.data.date.size() == 10);
      allow create: if isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().id == recordId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/employees/$(incoming().empId))
        && (
          isAdmin()
          || (
            recordId == incoming().date + '_' + incoming().empId
            && get(/databases/$(database)/documents/employees/$(incoming().empId)).data.active == true
            && incoming().status == 'on_duty'
            && incoming().outTime == null
            && incoming().startedAtMs is int
            && incoming().isPaused == false
            && (!('pausedAtMs' in incoming()) || incoming().pausedAtMs == null)
            && incoming().pausedTotalSeconds == 0
            && incoming().grossMinutes == null
            && incoming().netMinutes == null
            && incoming().netDecimalHours == null
            && incoming().overtimeMinutes == null
            && incoming().overtimeDecimalHours == null
            && incoming().breakMinutes == 30
            && incoming().syncedToSheet == false
          )
        );
      allow update: if isValidId(recordId)
        && isValidAttendance(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().status == 'on_duty'
            && existing().outTime == null
            && incoming().date == existing().date
            && incoming().empId == existing().empId
            && incoming().empCode == existing().empCode
            && incoming().empName == existing().empName
            && incoming().inTime == existing().inTime
            && incoming().breakMinutes == existing().breakMinutes
            && incoming().get('startedAtMs', null) == existing().get('startedAtMs', null)
            && incoming().syncedToSheet == false
            && (
              // Guard 1: Stop Timing (Pause)
              (
                existing().get('isPaused', false) == false
                && incoming().status == 'on_duty'
                && incoming().outTime == null
                && incoming().isPaused == true
                && incoming().pausedAtMs is int
                && incoming().pausedTotalSeconds == existing().get('pausedTotalSeconds', 0)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'isPaused',
                  'pausedAtMs',
                  'pausedTotalSeconds',
                  'isSunday',
                  'overtimeMinutes',
                  'overtimeDecimalHours',
                  'updatedAt'
                ])
              )
              ||
              // Guard 2: Start Timing (Resume)
              (
                existing().get('isPaused', false) == true
                && incoming().status == 'on_duty'
                && incoming().outTime == null
                && incoming().isPaused == false
                && incoming().pausedAtMs == null
                && incoming().pausedTotalSeconds >= existing().get('pausedTotalSeconds', 0)
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'isPaused',
                  'pausedAtMs',
                  'pausedTotalSeconds',
                  'isSunday',
                  'overtimeMinutes',
                  'overtimeDecimalHours',
                  'updatedAt'
                ])
              )
              ||
              // Guard 3: Mark OUT (Finalize shift)
              (
                incoming().status in ['completed', 'short_shift']
                && incoming().outTime is string
                && incoming().isPaused == false
                && incoming().pausedAtMs == null
                && incoming().pausedTotalSeconds >= existing().get('pausedTotalSeconds', 0)
                && incoming().grossMinutes is int
                && incoming().netMinutes is int
                && incoming().netDecimalHours is number
                && incoming().overtimeMinutes is int
                && incoming().overtimeDecimalHours is number
                && incoming().diff(existing()).affectedKeys().hasOnly([
                  'outTime',
                  'isPaused',
                  'pausedAtMs',
                  'pausedTotalSeconds',
                  'grossMinutes',
                  'netMinutes',
                  'netDecimalHours',
                  'overtimeMinutes',
                  'overtimeDecimalHours',
                  'presentCount',
                  'thikadaMinutes',
                  'normalMinutes',
                  'normalDecimalHours',
                  'isSunday',
                  'status',
                  'syncedToSheet',
                  'updatedAt'
                ])
              )
            )
          )
        );
      allow delete: if isAdmin() && isValidId(recordId);
    }

    match /settings/{settingId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(settingId)
        && isValidWorkspaceSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /admins/{uid} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /admin_emails/{email} {
      allow get: if isValidEmailId(email)
        && isSignedIn()
        && request.auth.token.email_verified == true
        && (isAdmin() || email == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidEmailId(email)
        && isValidAdminEmail(incoming())
        && incoming().email == email
        && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidEmailId(email);
    }
  }
}
